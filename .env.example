# ==============================================================================
# RAGLight configuration
# ==============================================================================
# Copy this file to `.env` and configure only the providers/features you use.
#
# Provider names:
#   Ollama
#   OpenAI
#   Mistral
#   GoogleGemini
#   AWSBedrock
#   HuggingFace        # embeddings
#   LmStudio
#   vLLM
#
# ------------------------------------------------------------------------------
# LLM
# ------------------------------------------------------------------------------

# Example: OpenAI
RAGLIGHT_LLM_PROVIDER=OpenAI
RAGLIGHT_LLM_MODEL=gpt-4.1-mini

# Optional.
# Leave unset to use the provider's default URL.
# Example OpenAI: https://api.openai.com/v1
# Example Ollama: http://localhost:11434
# RAGLIGHT_LLM_API_BASE=


# ------------------------------------------------------------------------------
# Embeddings
# ------------------------------------------------------------------------------

# Example: OpenAI
RAGLIGHT_EMBEDDINGS_PROVIDER=OpenAI
RAGLIGHT_EMBEDDINGS_MODEL=text-embedding-3-small

# Optional.
# Leave unset to use the provider's default URL.
# RAGLIGHT_EMBEDDINGS_API_BASE=


# ------------------------------------------------------------------------------
# Provider credentials
# ------------------------------------------------------------------------------

# Required only for the corresponding provider.

# OPENAI_API_KEY=
# MISTRAL_API_KEY=
# GEMINI_API_KEY=

# AWS credentials are normally loaded using the standard AWS credential chain:
# environment variables, ~/.aws/credentials, IAM role, etc.
# AWS_REGION=us-east-1


# ------------------------------------------------------------------------------
# Provider default URLs
# ------------------------------------------------------------------------------

# Optional global overrides.
#
# These are used when RAGLIGHT_LLM_API_BASE /
# RAGLIGHT_EMBEDDINGS_API_BASE are not explicitly configured.

# OPENAI_CLIENT_URL=https://api.openai.com/v1
# OLLAMA_CLIENT_URL=http://localhost:11434
# MISTRAL_CLIENT_URL=https://api.mistral.ai/v1
# LMSTUDIO_CLIENT=http://localhost:1234/v1
# GOOGLE_CLIENT_URL=


# ------------------------------------------------------------------------------
# Vector store
# ------------------------------------------------------------------------------

# Supported values:
#   Chroma
#   Qdrant

RAGLIGHT_DB=Qdrant

# Local persistence directory.
# Used when no remote DB host is configured.
RAGLIGHT_PERSIST_DIR=./raglight_db

RAGLIGHT_COLLECTION=default

# Optional remote vector database.
# Leave unset for local mode.
# RAGLIGHT_DB_HOST=localhost
# RAGLIGHT_DB_PORT=6333


# ------------------------------------------------------------------------------
# Retrieval
# ------------------------------------------------------------------------------

# Number of documents retrieved for each query.
RAGLIGHT_K=5


# ------------------------------------------------------------------------------
# System prompt
# ------------------------------------------------------------------------------

# Optional custom system prompt.
# RAGLIGHT_SYSTEM_PROMPT=


# ------------------------------------------------------------------------------
# Langfuse observability
# ------------------------------------------------------------------------------
# Requires:
#   pip install "raglight[langfuse]"
#
# LANGFUSE_HOST and LANGFUSE_BASE_URL are both supported.
# LANGFUSE_HOST takes precedence.

# LANGFUSE_HOST=
# LANGFUSE_BASE_URL=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=